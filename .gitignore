# .gitignore

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ──────────────────────
venv/
env/
.venv/
.env/

# ── Django ───────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/

# ── Environment secrets ──────────────────────
.env
.env.local
.env.production
*.env

# ── IDE ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing ──────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# ── Node (if any frontend build) ─────────────
node_modules/
npm-debug.log